# ============================================================
#  知识图谱模块配置  (tests/kg/)
# ------------------------------------------------------------
#  本文件**只服务 tests/kg/ 下的知识图谱程序**，与 LLM_server/.env 相互独立。
#  这样知识图谱模块可以整体拷走，只需要带上这个文件。
#
#  ⚠️ 本文件包含密钥，已在 .gitignore 中排除，不会提交进仓库。
# ============================================================

# ------------------------------------------------------------
# MySQL（图谱数据存在这里：kg_node / kg_edge / kg_alias）
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=ai250301

# ------------------------------------------------------------
# LLM（第 2 层「LLM 读图谱」用）
#   自检:  python tests/kg/config.py
#   探测:  python tests/kg/config.py --probe
# ------------------------------------------------------------
# 取值: dashscope | openai | maas | custom
LLM_PROVIDER=dashscope

# API Key（真实密钥，勿外传）
LLM_API_KEY=sk-your-real-api-key-here

# 自定义服务地址。留空则按 LLM_PROVIDER 预设；
# provider=maas/custom 时必须填，否则会明确报错
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# ── 模型分配（按用途）──────────────────────────────
#   ⚠️ 模型名必须与你的网关实际支持的清单一致，写错会 404 Model not exist
#      用 `python tests/kg/config.py --probe` 探测
LLM_MODEL_MAIN=qwen3.8-max        # 主对话、总结生成（质量优先）
LLM_MODEL_STANDARD=qwen3.8-27b    # 标准推理
LLM_MODEL_FAST=qwen3.8-flash      # 意图识别、路由、工具调用（速度优先）
LLM_MODEL_ASR=qwen-audio-3.0-asr-flash   # 语音识别（dashscope 原生 SDK）

# ── 通用参数 ──────────────────────────────────────
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# 总开关。False 时所有 LLM 调用降级（图谱的规则层仍可用）
LLM_ENABLED=True

# ------------------------------------------------------------
# 图谱算法参数
# ------------------------------------------------------------
# 置信度阈值：低于此值认为「推荐不可靠」，上层应回答「不确定」
#   = 第一名科室得票 / 总票数
KG_MIN_CONFIDENCE=0.15

# 儿科就诊年龄界限（周岁）
#   age < 此值 → 保留儿科科室；否则排除
#   年龄未知时也排除（综合医院成年患者占多数，给成年人推荐儿科更严重）
KG_PEDIATRIC_MAX_AGE=14
